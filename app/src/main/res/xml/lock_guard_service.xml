<?xml version="1.0" encoding="utf-8"?>
<!-- Only window-state events: enough to see a call, alarm or camera come over the keyguard.
     No window content, no key filtering: the keys stay with the system. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_guard_desc"
    android:settingsActivity="com.local.calltouchlock.MainActivity" />
