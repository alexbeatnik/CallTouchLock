<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="2dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_logo"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_stat_call_lock"
            app:tint="@color/ja_on_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/ja_text"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/statusIcon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_setting_icon"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/ja_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ja_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="1dp"
                        android:textColor="@color/ja_text_2"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/rowSaver"
                layout="@layout/item_setting"
                android:visibility="gone" />

            <include
                android:id="@+id/rowProtection"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowOverlay"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowPhone"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowBoot"
                layout="@layout/item_setting" />

            <include
                android:id="@+id/rowTest"
                layout="@layout/item_setting" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="8dp"
                android:text="@string/footer_hint"
                android:textColor="@color/ja_text_3"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Key hints -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            style="@style/CallTouchLock.Keycap"
            android:text="▴ ▾" />

        <TextView
            style="@style/CallTouchLock.KeyLabel"
            android:text="@string/hint_move" />

        <TextView
            style="@style/CallTouchLock.Keycap"
            android:text="OK" />

        <TextView
            style="@style/CallTouchLock.KeyLabel"
            android:layout_marginEnd="0dp"
            android:text="@string/hint_select" />
    </LinearLayout>
</LinearLayout>
